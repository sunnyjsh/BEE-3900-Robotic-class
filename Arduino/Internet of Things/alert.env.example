# Copy this file to alert.env and fill in your own values.
# Do NOT commit alert.env to GitHub (it is listed in .gitignore).
#
# Load it before running the script:
#   set -a; source alert.env; set +a

# ThingSpeak channel Write API Key (same one IoT_ex1.py uses)
THINGSPEAK_API_KEY=XXXXXXXXXXXXXXXX

# Twilio: Account SID and Auth Token from console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# Your Twilio phone number, and the phone to call. Use +1 and the area code.
TWILIO_FROM_NUMBER=+16075550100
ALERT_TO_NUMBER=+16075550199

# Call when temperature (deg C) is above this
TEMP_LIMIT=25

# Set to 1 to test without making a real call
DRY_RUN=0
